  "methods": {
    "parsing": "Read-only repository parsers parseReferenceCards, parseQuestions and parseChamberSources; history extracted as JSON literal; no runtime JavaScript evaluation.",
    "normalization": "URL only: force HTTPS; lowercase hostname; remove www.; strip fragment and final slash; remove utm_, fbclid, gclid query keys; sort remaining query params. DOI identity decoded from literal URL, lowercased and trailing /full|abstract|pdf|fulltext removed. PMID and PMCID only explicit URL identifiers. No title-similarity equivalence.",
    "usage": "mainQuestionUses counts unique qids in data/topics.js, not runtime sessions. chamberCaseUses counts exact case IDs bound by _appendCaseSources. Historical snapshots are listed separately and are not current consumers. All refsDB entries are catalogue cards, including entries without these two consumer surfaces.",
    "externalVerification": "None; URL targets and bibliographic correctness have not been verified online."
  },
